# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 지도와 장소 검색에 사용합니다.
# Kakao Developers > 플랫폼 > Web > 사이트 도메인에 http://localhost:5173 을 등록해야 동작합니다.
VITE_KAKAO_JS_KEY=

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
# 현재 프론트에서는 쓰지 않습니다. 카카오 호출을 백엔드로 옮길 때 서버 환경변수로 이동시킬 값입니다.
# 주의: VITE_ 접두어가 붙은 값은 클라이언트 번들에 그대로 포함되므로 비밀 키를 두면 노출됩니다.
VITE_KAKAO_REST_API=

# 백엔드 주소. 비워두면 프로덕션 빌드에서 메뉴/리뷰 기능이 자동으로 숨겨집니다.
# 개발 중에는 비워두세요. vite 프록시가 /api 를 localhost:8080 으로 넘깁니다.
# VITE_API_BASE_URL=

# 앱인토스 콘솔에 등록한 appName. 비워두면 'daedong-matmap' 을 사용합니다.
# apps-in-toss.config.ts 의 appName 과 반드시 같아야 합니다.
# VITE_AIT_APP_NAME=
